{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleDirectories": ["node_modules", "<rootDir>"],
  "moduleNameMapper": {
    "src/(.*)": "@tum-rating/backend/src/$1"
  },
  "preset": "ts-jest/presets/js-with-ts",
  "rootDir": ".",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "verbose": false
}