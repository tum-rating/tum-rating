{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleDirectories": ["../node_modules", "<rootDir>"],
  "moduleNameMapper": {
    "@tum-ratinng/(.*)": "../.."
  },
  "preset": "ts-jest/presets/js-with-ts",
  "rootDir": ".",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "verbose": false
}