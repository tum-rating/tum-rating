{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleDirectories": ["../node_modules", "<rootDir>"],
  "preset": "ts-jest/presets/js-with-ts",
  "rootDir": ".",
  "moduleNameMapper": {
    "^@tum-rating/(.*)$": "<rootDir>/../../$1"
  },
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "verbose": false,
  "testPathIgnorePatterns": [".*sequential.test*\\.(js|ts|jsx|tsx)$"]
}