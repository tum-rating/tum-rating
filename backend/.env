#APP
APP_PORT=3000
NODE_ENV=development

#MONGO
MONGO_URI=mongodb://root-user:root-password@localhost:27017/?directConnection=true
MONGO_DB=tum-rating

#JWT
JWT_SECRET=jwt-secret
JWT_EXPIRATION_TOKEN=5m
JWT_EXPIRATION_ACCESS_TOKEN=1d

#MAILER
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=user
MAILER_PASS=pass
MAILER_SENDER=TUM RATING<noreply@tum-rating.de>
MAILER_ADMIN_EMAILS=admin@email.com
MAILER_USE_HTLM_TEMPLATES=true

#SIGNUP
ACCEPTED_EMAILS_DOMAINS=mytum.de,tum.de

#WEBAPP
WEBAPP_PROTOCOL=http
WEBAPP_HOST=localhost
WEBAPP_PORT=5174
WEBAPP_SIGNUP_PATH="/#modal=sign-up"

#CACHE
CACHE_TTL_MINUTES=5

#OAUTH
OAUTH_IS_ENABLED=true
OAUTH_ISSUER_URL=http://localhost:1939/oidc
OAUTH_CLIENT_ID=client-id
OAUTH_CLIENT_SECRET=client-secret
OAUTH_REDIRECT_URL=http://localhost:3000/oauth/redirect
