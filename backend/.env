#APP
APP_PORT=3000
NODE_ENV=development

#MONGO
MONGO_URI=mongodb://root-user:root-password@localhost:27017
MONGO_DB=tum-rating

#JWT
JWT_SECRET=jwt-secret
JWT_EXPIRATION=1d

#MAILER
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=user
MAILER_PASS=pass
MAILER_SENDER=TUM RATING<noreply@tum-rating.de>
MAILER_ADMIN_EMAILS=admin@email.com

#SIGNUP
ACCEPTED_EMAILS_DOMAINS=mytum.de,tum.de

#WEBAPP
WEBAPP_PROTOCOL=http
WEBAPP_HOST=localhost
WEBAPP_PORT=5174
